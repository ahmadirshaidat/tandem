# Copy manually or run python3 infra/bootstrap.py to generate local secrets.
POSTGRES_PASSWORD=replace-with-a-random-local-password
DATABASE_URL=postgresql+psycopg://tandem:replace-with-a-random-local-password@localhost:5432/tandem
JWT_SECRET=replace-with-at-least-32-random-characters
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false
# Development writes real reset emails to a private local outbox.
# Production requires COOKIE_SECURE=true, MAIL_MODE=smtp and SMTP_HOST.
MAIL_MODE=outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Tandem <no-reply@localhost>
