# Copy manually or run python3 infra/bootstrap.py to generate local secrets.
POSTGRES_PASSWORD=replace-with-a-random-local-password
DATABASE_URL=postgresql+psycopg://tandem:replace-with-a-random-local-password@localhost:5432/tandem
JWT_SECRET=replace-with-at-least-32-random-characters
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false
# Development writes real reset emails to a private local outbox.
# Production requires COOKIE_SECURE=true, MAIL_MODE=smtp and SMTP_HOST.
MAIL_MODE=outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Tandem <no-reply@localhost>

# Backend-only provider keys. Never use NEXT_PUBLIC_ variables for secrets.
GROQ_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
TANDEM_OPENAI_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
DEEPSEEK_MODEL=deepseek-flash
GEMINI_MODEL=gemini-3.8-flash
OPENAI_MODEL=gpt-5.5
AI_PRIMARY_PROVIDER=groq
AI_PROVIDER_TIMEOUT_SECONDS=10
AI_MAX_OUTPUT_TOKENS=512
AI_REQUESTS_PER_MINUTE=5
