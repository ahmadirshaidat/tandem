# Copy manually or run python3 infra/bootstrap.py to generate local secrets.
POSTGRES_PASSWORD=replace-with-a-random-local-password
DATABASE_URL=postgresql+psycopg://tandem:replace-with-a-random-local-password@localhost:5432/tandem
JWT_SECRET=replace-with-at-least-32-random-characters
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false
# Development writes real reset emails to a private local outbox.
# Production requires COOKIE_SECURE=true, MAIL_MODE=smtp and SMTP_HOST.
MAIL_MODE=outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Tandem <no-reply@localhost>

# Backend-only provider keys. Never use NEXT_PUBLIC_ variables for secrets.
GROQ_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
TANDEM_OPENAI_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
DEEPSEEK_MODEL=deepseek-flash
GEMINI_MODEL=gemini-3.5-flash
OPENAI_MODEL=gpt-5.5
AI_PRIMARY_PROVIDER=groq
AI_PROVIDER_TIMEOUT_SECONDS=10
AI_MAX_OUTPUT_TOKENS=512
AI_REQUESTS_PER_MINUTE=5

# Slice 2: one backend worker; authorized images stored outside public files.
ATTACHMENT_DIR=.local/attachments
# Sends and edits per user per rolling minute; idempotent retries do not count.
MESSAGE_REQUESTS_PER_MINUTE=60
# Limits apply across all workspaces, per backend process.
WS_CONNECTIONS_PER_USER=5
WS_CONNECTIONS_PER_IP=30
WS_FRAMES_PER_MINUTE=120
# Browser sends a ping every 15 seconds. Frame limit is fixed at 8 KiB.
WS_IDLE_SECONDS=60

# Slice 3 uses the existing database, auth and WebSocket settings above.
# No additional secrets or provider credentials are required for projects/tasks.

# Shared read-only agent. Owner/Admin enable it per workspace in Agent settings.
# Groq -> Gemini by default; DeepSeek/OpenAI require Owner opt-in.
# Model names and keys above are reused. Startup reports model availability.
AGENT_WORKER_ENABLED=true
AGENT_RUN_TIMEOUT_SECONDS=60
AGENT_WORKSPACE_CONCURRENCY=1
AGENT_WORKER_SLOTS=4
AGENT_USER_RUNS_PER_MINUTE=5
AGENT_WORKSPACE_RUNS_PER_MINUTE=20
# Test/development only; leave false with real users. No network or keys in fake mode.
AGENT_FAKE_PROVIDER=false
AGENT_PROVIDER_TIMEOUT_SECONDS=15
AGENT_MAX_OUTPUT_TOKENS=2048

# Proposal records only; a human approval is always required for domain changes.
PROPOSAL_EXPIRY_DAYS=7
PROPOSAL_PENDING_PER_CHANNEL=20
# Create-task approval defaults to Editor/Admin and can be tightened in Agent settings.
# Reassignment, priority changes and deletion always require Admin/Owner.
