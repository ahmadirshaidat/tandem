FROM python:3.12-slim
RUN pip install --no-cache-dir uv==0.12.23
WORKDIR /app
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-dev
COPY backend/ ./
COPY infra/hosted_backend.py ./hosted_backend.py
ENV PATH="/app/.venv/bin:$PATH" PYTHONUNBUFFERED=1
RUN useradd --create-home --uid 10001 tandem && mkdir -p /data && chown -R tandem:tandem /app /data
USER tandem
EXPOSE 8000
CMD ["python", "hosted_backend.py"]
