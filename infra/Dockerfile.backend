FROM python:3.12-slim
RUN --mount=type=secret,id=proxy_ca \
    if [ -s /run/secrets/proxy_ca ]; then export PIP_CERT=/run/secrets/proxy_ca; fi; \
    pip install --no-cache-dir uv==0.12.23
WORKDIR /app
COPY backend/pyproject.toml backend/uv.lock ./
RUN --mount=type=secret,id=proxy_ca \
    if [ -s /run/secrets/proxy_ca ]; then export SSL_CERT_FILE=/run/secrets/proxy_ca; fi; \
    uv sync --frozen
COPY backend/ ./
ENV PATH="/app/.venv/bin:$PATH"
RUN useradd --create-home --uid 10001 tandem && mkdir -p /app/.local/mail /app/.local/attachments && chown -R tandem:tandem /app
USER tandem
EXPOSE 8000
CMD ["sh", "-c", "alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port 8000 --no-access-log --ws-max-size 8192 --ws-ping-interval 15 --ws-ping-timeout 20"]
